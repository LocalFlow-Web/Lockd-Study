# Copy this file to .env.local and paste your key in.
# Leave it empty to run in demo mode (sample notes, no cost).
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-haiku-5-5.
# LOCKD_MODEL=claude-haiku-5-5

# Logins and saving to accounts (Supabase). Leave empty to run in local mode:
# no login, everything saved in the browser, no upload limits.
# Find both in Supabase: Project Settings → API Keys. Never use the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Free uploads per person per 24 hours (default 3).
# DAILY_UPLOAD_LIMIT=3

# Set to true only after custom SMTP is connected and supabase/reset-password-email.html
# is pasted into Authentication → Emails → Reset Password (it adds a 6-digit code).
# NEXT_PUBLIC_RESET_EMAIL_HAS_CODE=true
